# OpenGPS — the variables of an installation, whichever way it is installed
# (deploy/README.md). .github/scripts/env-check.sh keeps this file and the
# compose files of deploy/ saying the same.
#
# With Docker Compose (deploy/docker-compose, deploy/caddy, deploy/cloudflare):
# copy it to .env next to docker-compose.yml, or let generate-env.sh write that
# file with its secrets already generated. Each release attaches it as
# env.example, with its version filled in.
# With Dokploy: paste the variables in the Environment tab of the Compose app
# (deploy/generate-env.sh <domain> prints them ready to paste).
# With Coolify: only OPENGPS_VERSION is written. Coolify generates the secrets
# and gives the address from the domain set for the `opengps` service.
#
# Everything else about the platform (mail, map, address service, legal
# contact, data periods, notifications, sign-in, storage, backups) is set up
# from its console, Administration → System, by the first account, which
# becomes its owner.
#
# Write each value as is, without quotes.

# ─── Required ───────────────────────────────────────────────────────────────
# Coolify sets the first three on its own.
#
# Address of the web app, as visitors open it.
PUBLIC_URL=https://example.com
# Signs the sessions and encrypts the keys saved in the console. Generate it
# with: openssl rand -hex 32. Changing it later signs everybody out and those
# keys have to be written again.
AUTH_SECRET=
# Password of the database's only user. Generate it with: openssl rand -hex 32.
# Letters and numbers only: it goes inside an address. It takes effect the
# first time the database starts.
POSTGRES_PASSWORD=
# The OpenGPS version this installation runs: the tag of its images (0.1.0).
# generate-env.sh fills it in; to install another version, change it and run
# docker compose up -d again (ADR-0003).
OPENGPS_VERSION=

# ─── deploy/docker-compose: the web app on a port of the server ─────────────
# Port of the server where the web app and the API answer, in plain HTTP.
WEB_PORT=3000
# Address that port listens on. 0.0.0.0 = whoever reaches the server;
# 127.0.0.1 = only the server itself, for a proxy installed on it.
WEB_BIND=0.0.0.0

# ─── deploy/caddy: the domain with HTTPS from Caddy ─────────────────────────
# The sites Caddy serves and gets a certificate for, comma-separated. Empty =
# PUBLIC_URL alone. With the API's own name:
# https://example.com, https://api.example.com
CADDY_SITES=

# ─── deploy/cloudflare: the domain through a Cloudflare Tunnel ──────────────
# The token Cloudflare gives when the tunnel is created. Required with this
# way of installing; the others do not use it.
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Optional: the platform ─────────────────────────────────────────────────
# Name of the platform: title, emails, notifications.
APP_NAME=OpenGPS
# Name the GPS devices point to. By default, gw.<domain of PUBLIC_URL>. Its DNS
# record goes straight to the server: no proxy in front (in Cloudflare, "DNS only").
DEVICE_GATEWAY_HOST=
# Public IP of the server, shown to whoever sets up a device that only accepts a number.
DEVICE_GATEWAY_IP=
# Other addresses the web app is also opened at, besides PUBLIC_URL,
# comma-separated: signing in and saving changes work from them too. Example:
# http://192.168.1.10:3000
TRUSTED_ORIGINS=
# Simulated devices the console's simulator can run at once (1 to 5000).
SIMULATOR_MAX_DEVICES=50
# GitHub repository whose releases are newer versions of this installation; its
# owner sees them in the console. Empty turns the look off. Left out, it is
# afigueroahn/OpenGPS.
# UPDATE_REPOSITORY=

# ─── Optional: the database and the stack ───────────────────────────────────
# The database's only user, used by the platform, the device gateway and the
# backups. Letters, numbers and _ only. Takes effect the first time it starts.
POSTGRES_USER=postgres
# Name of the platform's database. The device gateway's is always traccar.
# Takes effect the first time it starts.
POSTGRES_DB=opengps
# Name of the stack in Docker Compose. Dokploy and Coolify name it themselves.
COMPOSE_PROJECT_NAME=opengps

# ─── Small servers (2 GB of RAM or less) ────────────────────────────────────
# Memory Postgres assumes it has; only applied the first time it starts. Example: 768MB
POSTGRES_TUNE_MEMORY=
# Java options of the device gateway. Example: -Xmx320m
TRACCAR_JAVA_OPTS=
