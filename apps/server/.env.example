# Backend variables for development and tests on your machine. Copy this file
# as .env.local. These are test values: they are of no use on the server.
#
# They need Postgres with TimescaleDB at 127.0.0.1:5434, with the opengps and
# traccar databases and this password ("Desarrollo y pruebas" in README.md).
# The tests simulate Traccar and the mail server.
#
# The outgoing mail, the map, the address and routing services and the rest of
# what the platform's admin console defines are not variables: they are set in
# the console (ADR-0010). Until a mail server is set there, no mail is sent,
# and the first account gets in without confirming its email.

PORT=3000
APP_NAME=OpenGPS
# The development web app (Vite) forwards /api to the backend.
PUBLIC_URL=http://localhost:5173

AUTH_SECRET=local-development-only-0123456789abcdef

DATABASE_URL=postgres://postgres:postgres-local@127.0.0.1:5434/opengps
TRACCAR_DATABASE_URL=postgres://postgres:postgres-local@127.0.0.1:5434/traccar
TRACCAR_API_URL=http://127.0.0.1:8082
TRACCAR_ADMIN_EMAIL=plataforma@gps.local
TRACCAR_ADMIN_PASSWORD=traccar-admin-local
# Without a Traccar to talk to, the backend waits for it. With this on it does
# not: it serves the web app and the API, without reading positions or running
# its background jobs.
DISABLE_BACKGROUND=1

# The rest of what the backend reads, with the value each one has when it is
# not set. Nothing here needs changing to develop.

# development, test or production.
# NODE_ENV=development
# The address the backend listens on.
# HOST=0.0.0.0
# The release an image is, set when the image is built. Empty: the version of
# the code, with -dev.
# APP_VERSION=
# GitHub repository whose releases are the new versions. Empty: no looking.
# UPDATE_REPOSITORY=afigueroahn/OpenGPS
# Where the platform's files and its backups are kept.
# FILES_DIR=/data/files
# BACKUP_DIR=/data/backups
# Where the migrations are. Empty: db/migrations of the repository.
# MIGRATIONS_DIR=
# The built web app, for the backend to serve it. Empty: Vite serves it.
# WEB_DIR=
# Where Twilio, the SMS service, is reached.
# TWILIO_API_URL=https://api.twilio.com
# The rclone program, for the external storage.
# RCLONE_BIN=rclone
