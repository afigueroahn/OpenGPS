{
  "name": "@opengps/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenGPS backend: API, sign-in, WebSocket, ingest and jobs",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:schema": "tsx --env-file=.env.local scripts/auth-schema.ts",
    "lint": "oxlint src test scripts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.27",
    "@fastify/websocket": "^11.3.7",
    "@opengps/shared": "workspace:*",
    "better-auth": "1.7.27",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.1",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1",
    "ws": "^8.23.0"
  }
}
